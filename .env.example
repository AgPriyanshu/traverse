# Traverse — copy to .env and edit. `.env` is gitignored and must never be
# committed (AGENTS.md § No secrets).
#
#   cp .env.example .env          # or: make env, which also fills the secrets
#
# Two kinds of key live here:
#   * compose keys  — interpolated by docker-compose.yml (host ports, images)
#   * settings keys — read by api/config/settings.py (pydantic-settings maps
#                     each field to its UPPER_CASE name)
#
# Inside compose, service names are used for hosts (db, neo4j, rabbitmq, minio)
# and compose sets them itself. The localhost values below are for running the
# app or a test on the host, which is what a worktree does.

# ── Environment ───────────────────────────────────────────────────────────────
ENV=development
# Host port for the API. BRANCH.md §4: 8000 int · 8001 be1 · 8002 be2 · 8003 fe1.
API_PORT=8000

# ── Postgres (source of truth) ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5433
# Created on a cold volume and by scripts/bootstrap_databases.sh, each with the
# vector extension. One per agent — BRANCH.md §4 — plus `traverse_test`, which
# the `test` compose service truncates between runs and must never be
# traverse_int (that's live integration data).
AGENT_DATABASES=traverse_be1 traverse_be2 traverse_int traverse_test
# Point this at your own slice: traverse_be1 / traverse_be2 / traverse_int.
POSTGRES_DB_STRING=postgresql+psycopg://postgres:postgres@localhost:5433/traverse_int

# ── Neo4j (a rebuildable projection of Postgres) ──────────────────────────────
# Community edition is single-database: be2 has exclusive write access.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=very_safe_password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PAGECACHE=512m

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# Vhosts created at boot by docker/rabbitmq/init-vhosts.sh.
RABBITMQ_VHOSTS=be1 be2 int
# The vhost this process uses, percent-encoded: %2Fbe1 is the vhost "/be1".
# A bare "be1" is a different vhost that does not exist.
RABBITMQ_VHOST=%2Fint
RABBITMQ_URL=pyamqp://guest:guest@localhost:5672/%2Fint
CELERY_RESULT_BACKEND=rpc://
CELERY_CONCURRENCY=2
# 1 → the celery-worker healthcheck fails unless all nine names in
# api/tasks.STAGES are registered. Set 0 while the stages are being written.
CELERY_REQUIRE_STAGES=1

# ── Object storage ────────────────────────────────────────────────────────────
# 9002/9003, not 9000/9001: another stack on this machine holds 9000 and
# 9090/9091. Inside compose the address is always minio:9000.
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKETS=traverse-be1 traverse-be2 traverse-int
MINIO_BUCKET=traverse-int

# ── Inference ─────────────────────────────────────────────────────────────────
# api = call a hosted model, local = call the vLLM in the gpu profile,
# routed = decide per purpose. Default is api so the demo runs without a GPU
# (PRD NFR-deploy); `make up-gpu` flips it to local.
INFERENCE_MODE=api
VLLM_BASE_URL=http://localhost:8080/v1/
VLLM_PORT=8080
LLM_MODEL=Qwen/Qwen3-8B-AWQ
LLM_MAX_CONTEXT=16384
LLM_OUTPUT_RESERVE=2048
LLM_MAX_CONCURRENCY=8
# Optional escalation model. Leave both blank to disable every egress path.
FRONTIER_MODEL=
FRONTIER_API_KEY=
# Only needed to pull a gated model into the vLLM cache.
HF_TOKEN=

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# cpu in a worktree: BGE-M3 on CUDA from two worker processes OOMs a consumer
# card (BRANCH.md §9). GPU embedding is exercised during integration only.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# ── Model cache ───────────────────────────────────────────────────────────────
# Never a host-specific absolute path in code. In containers this is the shared
# volume; on the host, point it wherever you keep the cache.
MODELS_CACHE_DIR=/models
DOCLING_ARTIFACTS_DIR=/models/docling
MODEL_CACHE_VOLUME=traverse_model_cache
# 1 also sets HF_HUB_OFFLINE and TRANSFORMERS_OFFLINE. Tests run with this on
# and must not reach the network; fill the cache once with `make warm-models`.
MODELS_OFFLINE=1

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_PORT=3000
LANGFUSE_BASE_URL=http://localhost:3000
# From the Langfuse UI after `make up-obs` → create a project. Blank disables
# tracing (settings.langfuse_enabled).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse runs on its own Postgres — it applies its own Prisma migrations and
# sharing the app cluster makes `alembic downgrade` unsafe.
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
# REQUIRED for the obs profile, and never committed. `make env` generates them:
#   openssl rand -base64 32          → NEXTAUTH_SECRET, SALT
#   openssl rand -hex 32             → ENCRYPTION_KEY (exactly 64 hex chars)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# ── Health gating ─────────────────────────────────────────────────────────────
# Which dependencies make /health "degraded". The CI subset runs Postgres and
# RabbitMQ only and narrows this to db,broker.
HEALTH_REQUIRED_DEPS=db,broker,neo4j,object_store

# ── Web ───────────────────────────────────────────────────────────────────────
# nginx-served build. Vite dev server is 5173 (fe1) / 5174 (int) — BRANCH.md §4.
WEB_PORT=5174
VITE_PORT=5173
FLOWER_PORT=5555

# ── Images ────────────────────────────────────────────────────────────────────
TRAVERSE_TAG=dev

# ── Image pins ────────────────────────────────────────────────────────────────
# MinIO publishes to quay.io; `minio/minio` on Docker Hub is not pullable
# anonymously any more.
MINIO_IMAGE_TAG=RELEASE.2025-09-07T16-13-09Z
MC_IMAGE_TAG=RELEASE.2025-08-13T08-35-41Z
